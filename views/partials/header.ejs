<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · ScolarGuide</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="nav">
  <a class="brand" href="/">Scolar<span>Guide</span></a>
  <nav>
    <% if (user) { %>
      <a href="/dashboard">Dashboard</a>
      <form action="/logout" method="POST" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="link-btn">Log out (<%= user.name %>)</button>
      </form>
    <% } else { %>
      <a href="/login">Log in</a>
      <a class="btn small" href="/register">Sign up</a>
    <% } %>
  </nav>
</header>
<main>